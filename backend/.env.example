# Example configuration for the voice-recorder backend.
# Copy to `.env` for local development. Contains NO secrets — production Azure access
# uses a shared user-assigned managed identity (its client id is provided to the
# container via AZURE_CLIENT_ID for DefaultAzureCredential), never keys or connection
# strings. Every variable is prefixed with VR_.

# ------------------------------------------------------------------ environment
# production | local | test
VR_ENVIRONMENT=local
VR_LOG_LEVEL=INFO

# ------------------------------------------------------------------------- auth
# Google OIDC ID-token validation. Comma-separated audiences (Android/Web + Desktop
# client IDs). Never commit real client IDs or the allowlisted email to the repo.
VR_GOOGLE_ALLOWED_AUDIENCES=REPLACE_ANDROID_CLIENT_ID.apps.googleusercontent.com,REPLACE_DESKTOP_CLIENT_ID.apps.googleusercontent.com
VR_GOOGLE_ALLOWED_ISSUERS=https://accounts.google.com,accounts.google.com
VR_GOOGLE_JWKS_URI=https://www.googleapis.com/oauth2/v3/certs
VR_ALLOWLISTED_EMAIL=REPLACE_WITH_OWNER_EMAIL
# Local-only shortcut to bypass Google validation (accepts the token "dev-token").
# MUST remain false in production (enforced by config validation).
VR_AUTH_DISABLED=false

# ---------------------------------------------------------------------- storage
# Production: set the account name; SDKs build normal account URLs and authenticate
# with managed identity over private endpoints.
VR_STORAGE_ACCOUNT_NAME=REPLACE_STORAGE_ACCOUNT_NAME
# Local test mode ONLY: use the Azurite development connection string. Forbidden in
# production. When true, the built-in Azurite dev connection string is used unless
# VR_STORAGE_AZURITE_CONNECTION_STRING overrides it.
VR_STORAGE_USE_AZURITE=true
# Local smoke ONLY: fully in-memory storage (no Azurite/Docker needed). Forbidden in
# production. Overrides VR_STORAGE_USE_AZURITE when true.
VR_USE_FAKE_STORAGE=false
VR_AUDIO_CONTAINER=audio
VR_TRANSCRIPT_CONTAINER=transcripts
VR_RAW_CONTAINER=raw
VR_WORK_QUEUE=work
VR_RECORDINGS_TABLE=recordings
VR_CHUNKS_TABLE=chunks
VR_TRANSCRIPTS_TABLE=transcripts

# ------------------------------------------------------------------ AI Foundry
# Azure AI Services (Azure OpenAI) endpoint + deployments. Auth is Entra token via
# managed identity — no key. Endpoint and deployments are configurable.
VR_FOUNDRY_ENDPOINT=https://tomaskubica-foundry-resource.cognitiveservices.azure.com/
VR_FOUNDRY_API_VERSION=2024-10-21
VR_TRANSCRIBE_DEPLOYMENT=gpt-4o-transcribe
VR_REFINE_DEPLOYMENT_DEFAULT=gpt-5.6-luna
VR_REFINE_DEPLOYMENT_ALTERNATIVE=gpt-5.6-terra
# Local test mode ONLY: swap the Foundry client for a deterministic fake.
VR_USE_FAKE_AI=true

# ----------------------------------------------------------------- Web PubSub
# Managed-identity Web PubSub endpoint (required in production).
VR_WEBPUBSUB_ENDPOINT=https://REPLACE.webpubsub.azure.com
VR_WEBPUBSUB_HUB=transcripts
VR_WEBPUBSUB_GROUP=user
VR_WEBPUBSUB_TOKEN_TTL_MINUTES=60
# Local test mode ONLY: swap Web PubSub for an in-memory gateway.
VR_USE_FAKE_REALTIME=true

# ------------------------------------------------------------------ behaviour
VR_TRANSCRIBE_LANGUAGE=cs
VR_MAX_CHUNK_BYTES=8388608
VR_RETENTION_HOURS=48
VR_CHUNK_GRACE_SECONDS=900
VR_MAX_TRANSCRIBE_ATTEMPTS=5
VR_MAX_REFINE_ATTEMPTS=5
# Messages pulled per receive. Keep at 1: the worker processes messages sequentially,
# so a larger batch would let the last message's visibility lease expire while the
# first is still being transcribed (duplicate Foundry calls).
VR_QUEUE_BATCH_SIZE=1
# Processing lease for a dequeued message. Must comfortably exceed the slowest Foundry
# transcription/refinement round-trip.
VR_QUEUE_VISIBILITY_SECONDS=300
# Base of the exponential backoff applied between retry attempts of a failed message.
VR_QUEUE_RETRY_BASE_SECONDS=30
VR_PREVIEW_MAX_CHARS=140
# Concise technical glossary that biases transcription toward correct spellings.
VR_GLOSSARY_TERMS=Microsoft, Azure, GitHub, SDK, API, AI, Container Apps, Managed Identity, Foundry, Copilot, Kubernetes, Entra, OpenAI, FastAPI, Web PubSub, OIDC, JWT
