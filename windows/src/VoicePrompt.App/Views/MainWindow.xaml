<Window x:Class="VoicePrompt.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VoicePrompt.App.Views"
        Title="VoicePrompt"
        Width="720" Height="540"
        MinWidth="560" MinHeight="420"
        Background="{StaticResource CanvasBrush}"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FocusManager.FocusedElement="{Binding ElementName=Tabs}">

  <Window.InputBindings>
    <KeyBinding Key="Escape" Command="{x:Static local:MainWindow.HideWindowCommand}" />
    <KeyBinding Key="F5" Command="{x:Static local:MainWindow.RefreshCommand}" />
  </Window.InputBindings>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Grid.Row="0" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Image Grid.Column="0" Source="/Assets/app.png" Width="40" Height="40"
             Margin="0,0,12,0" AutomationProperties.Name="VoicePrompt logo" />

      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Text="VoicePrompt" FontSize="17" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource Caption}"
                   Text="Transcripts arrive from the cloud and land on your clipboard." />
      </StackPanel>
    </Grid>

    <!-- Status strip -->
    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
            CornerRadius="4" Padding="12,10" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <TextBlock Style="{StaticResource Caption}" Text="CONNECTION" />
          <TextBlock x:Name="ConnectionText" Text="Stopped" FontWeight="SemiBold"
                     AutomationProperties.Name="Realtime connection state" />
        </StackPanel>

        <StackPanel Grid.Column="1">
          <TextBlock Style="{StaticResource Caption}" Text="ACCOUNT" />
          <TextBlock x:Name="AuthText" Text="Signed out" FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis"
                     AutomationProperties.Name="Authentication state" />
        </StackPanel>

        <StackPanel Grid.Column="2">
          <TextBlock Style="{StaticResource Caption}" Text="CACHED TRANSCRIPTS" />
          <TextBlock x:Name="CacheText" Text="0" FontWeight="SemiBold"
                     AutomationProperties.Name="Number of cached transcripts" />
        </StackPanel>
      </Grid>
    </Border>

    <TabControl x:Name="Tabs" Grid.Row="2" Background="Transparent" BorderThickness="0"
                AutomationProperties.Name="Sections">

      <!-- ============================ History ============================ -->
      <TabItem Header="_History">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <ListBox x:Name="HistoryList"
                   Grid.Row="0"
                   SelectionChanged="OnHistorySelectionChanged"
                   AutomationProperties.Name="Cached transcripts, newest first"
                   MouseDoubleClick="OnHistoryDoubleClick"
                   KeyDown="OnHistoryKeyDown">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding Preview}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Style="{StaticResource Caption}" Text="{Binding Meta}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock x:Name="EmptyHistoryText" Grid.Row="0"
                     Style="{StaticResource Caption}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     TextAlignment="Center"
                     Text="No transcripts cached yet.&#x0a;Completed transcripts appear here for 48 hours."
                     Visibility="Collapsed" />

          <WrapPanel Grid.Row="1" Margin="0,12,0,0">
            <Button x:Name="CopySelectedButton" Content="_Copy selected" Click="OnCopySelected"
                    Style="{StaticResource AccentButton}"
                    AutomationProperties.Name="Copy the selected transcript to the clipboard" />
            <Button x:Name="CopyLatestButton" Content="Copy _latest" Click="OnCopyLatest" Margin="8,0,0,0"
                    AutomationProperties.Name="Copy the newest transcript to the clipboard" />
            <Button x:Name="CopyOriginalButton" Content="Copy _original" Click="OnCopyOriginal" Margin="8,0,0,0"
                    IsEnabled="False" AutomationProperties.Name="Copy original dictation before AI cleanup" />
            <Button x:Name="RefreshButton" Content="_Refresh" Click="OnRefresh" Margin="8,0,0,0"
                    AutomationProperties.Name="Refresh history from the backend" />
            <Button x:Name="ClearHistoryButton" Content="Clear _history" Click="OnClearHistory" Margin="8,0,0,0"
                    AutomationProperties.Name="Delete all locally cached transcripts" />
          </WrapPanel>
        </Grid>
      </TabItem>

      <TabItem Header="_Recovery">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8"
                     Text="Interrupted dictations are encrypted for this Windows user and retained for 48 hours. Recover finishes cloud transcription into History; it never pastes automatically. Use the original account and backend. Recovery storage is limited to 256 MiB." />
          <ListBox x:Name="RecoveryList" Grid.Row="1" AutomationProperties.Name="Recoverable dictations">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding UpdatedAt, StringFormat={}{0:g}}" />
                  <TextBlock Text="{Binding PendingChunks, StringFormat={}{0} sealed chunks pending (recovery also finishes the audio tail)}" />
                  <TextBlock Text="{Binding Language, StringFormat={}Language: {0}}" />
                  <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="RecoverButton" Content="Recover to History" Click="OnRecover" />
            <Button Content="Refresh" Click="OnRefreshRecovery" Margin="8,0,0,0" />
            <Button Content="Discard selected" Click="OnDiscardRecovery" Margin="8,0,0,0" />
          </StackPanel>
          <TextBlock x:Name="RecoveryStatusText" Grid.Row="3" Style="{StaticResource Caption}"
                     TextWrapping="Wrap" Margin="0,8,0,0" />
        </Grid>
      </TabItem>

      <!-- ============================ Settings ============================ -->
      <TabItem Header="_Settings">
        <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel>

            <TextBlock Style="{StaticResource SectionHeader}" Text="Backend" />
            <TextBlock Style="{StaticResource Caption}" Text="API base URL" Margin="0,0,0,4" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="BackendUrlBox" Grid.Column="0"
                       AutomationProperties.Name="Backend API base URL" />
              <Button x:Name="ApplyUrlButton" Grid.Column="1" Content="_Apply" Margin="8,0,0,0"
                      Click="OnApplyUrl"
                      AutomationProperties.Name="Apply the backend URL" />
            </Grid>
            <TextBlock x:Name="BackendHealthText" Style="{StaticResource Caption}" Margin="0,6,0,0"
                       Text="Health not checked yet." />
            <Button x:Name="CheckHealthButton" Content="Check _connection" Click="OnCheckHealth"
                    HorizontalAlignment="Left" Margin="0,8,0,0"
                    AutomationProperties.Name="Check backend health" />

            <Separator Margin="0,18" Background="{StaticResource LineBrush}" />

            <TextBlock Style="{StaticResource SectionHeader}" Text="Google account" />
            <TextBlock x:Name="AuthDetailText" Style="{StaticResource Caption}" TextWrapping="Wrap"
                       Text="Not signed in." />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button x:Name="SignInButton" Content="Sign _in" Click="OnSignIn"
                      Style="{StaticResource AccentButton}"
                      AutomationProperties.Name="Sign in with Google in the system browser" />
              <Button x:Name="SignOutButton" Content="Sign _out" Click="OnSignOut" Margin="8,0,0,0"
                      AutomationProperties.Name="Sign out and delete cached tokens" />
            </StackPanel>

            <Separator Margin="0,18" Background="{StaticResource LineBrush}" />

            <TextBlock Style="{StaticResource SectionHeader}" Text="Behaviour" />
            <CheckBox x:Name="AutoStartCheck" Content="Start _automatically when I sign in to Windows"
                      Click="OnAutoStartChanged"
                      AutomationProperties.Name="Start VoicePrompt automatically at Windows sign-in" />
            <CheckBox x:Name="PauseCheck" Content="_Pause notifications (do not auto-copy transcripts)"
                      Click="OnPauseChanged"
                      AutomationProperties.Name="Pause notifications and automatic clipboard copying" />

            <Separator Margin="0,18" Background="{StaticResource LineBrush}" />

            <TextBlock Style="{StaticResource SectionHeader}" Text="Local dictation with cloud MAI" />
            <CheckBox x:Name="DictationEnabledCheck" Content="Enable global dictation shortcut"
                      AutomationProperties.Name="Enable dictation" />
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                       Text="Hold to talk and release to finish, or use the hands-free shortcut to start/stop. Esc discards. There is no five-minute stop. MAI transcribes in the background; a non-activating overlay previews recent words. Encrypted local checkpoints are saved about every two seconds for crash recovery (48-hour retention, 256 MiB storage limit)." />
            <TextBlock Style="{StaticResource Caption}" Text="Shortcut (for example Ctrl+Alt+Space)" Margin="0,8,0,4" />
            <TextBox x:Name="DictationShortcutBox" AutomationProperties.Name="Dictation shortcut" />
            <TextBlock Style="{StaticResource Caption}" Text="Hands-free start/stop shortcut" Margin="0,8,0,4" />
            <TextBox x:Name="DictationToggleShortcutBox" AutomationProperties.Name="Hands-free dictation shortcut" />
            <TextBlock Style="{StaticResource Caption}" Text="Recognition language" Margin="0,8,0,4" />
            <ComboBox x:Name="DictationLanguageBox" AutomationProperties.Name="Dictation language">
              <ComboBoxItem Content="Automatic (including Czech / English switching)" />
              <ComboBoxItem Content="Czech" />
              <ComboBoxItem Content="English" />
            </ComboBox>
            <CheckBox x:Name="DictationRefinementCheck" Content="Polish dictation with LLM (optional)"
                      Margin="0,10,0,0" AutomationProperties.Name="Enable optional cloud AI dictation cleanup" />
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                       Text="The AI model is configured on the backend. It starts with shorter text windows and grows to 75 words. After Stop, it can use any time left in your wait limit to clean the final transcript. If AI is late, the available edits and original ending are pasted. The last MAI transcription, History save and clipboard may still take longer. AI can make mistakes. History keeps both versions for 48 hours in the existing unencrypted local text cache; Copy original restores the MAI text. Recovery restores original text without AI cleanup." />
            <TextBlock Style="{StaticResource Caption}" Text="Maximum wait from Stop for optional AI (default 1.5 s)" Margin="0,8,0,4" />
            <ComboBox x:Name="DictationFinalWaitBox" Width="120" HorizontalAlignment="Left"
                      AutomationProperties.Name="Maximum wait from Stop for optional AI">
              <ComboBoxItem Content="0.5 s" />
              <ComboBoxItem Content="1.0 s" />
              <ComboBoxItem Content="1.5 s" />
              <ComboBoxItem Content="2.0 s" />
              <ComboBoxItem Content="2.5 s" />
              <ComboBoxItem Content="3.0 s" />
              <ComboBoxItem Content="3.5 s" />
              <ComboBoxItem Content="4.0 s" />
              <ComboBoxItem Content="4.5 s" />
              <ComboBoxItem Content="5.0 s" />
            </ComboBox>
            <Button Content="Apply dictation settings" Click="OnApplyDictation"
                    HorizontalAlignment="Left" Margin="0,8,0,0" />
            <TextBlock x:Name="DictationStatusText" Style="{StaticResource Caption}" TextWrapping="Wrap"
                       Margin="0,6,0,0" Text="Hold: Ctrl+Alt+Space. Hands-free: Ctrl+Alt+Shift+Space. Hands-free allows switching windows: focus your destination BEFORE stopping. Paste targets the window focused at stop; it may paste into the wrong input if you choose the wrong window. Changing focus while finishing skips paste. Clipboard/History remain the fallback." />

            <Separator Margin="0,18" Background="{StaticResource LineBrush}" />

            <TextBlock Style="{StaticResource SectionHeader}" Text="About" />
            <TextBlock x:Name="AboutText" Style="{StaticResource Caption}" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
