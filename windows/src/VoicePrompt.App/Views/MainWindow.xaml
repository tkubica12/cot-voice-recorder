<Window x:Class="VoicePrompt.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VoicePrompt.App.Views"
        Title="VoicePrompt"
        Width="720" Height="540"
        MinWidth="560" MinHeight="420"
        Background="{StaticResource CanvasBrush}"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FocusManager.FocusedElement="{Binding ElementName=Tabs}">

  <Window.InputBindings>
    <KeyBinding Key="Escape" Command="{x:Static local:MainWindow.HideWindowCommand}" />
    <KeyBinding Key="F5" Command="{x:Static local:MainWindow.RefreshCommand}" />
  </Window.InputBindings>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Grid.Row="0" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Image Grid.Column="0" Source="/Assets/app.png" Width="40" Height="40"
             Margin="0,0,12,0" AutomationProperties.Name="VoicePrompt logo" />

      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Text="VoicePrompt" FontSize="17" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource Caption}"
                   Text="Transcripts arrive from the cloud and land on your clipboard." />
      </StackPanel>
    </Grid>

    <!-- Status strip -->
    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
            CornerRadius="4" Padding="12,10" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <TextBlock Style="{StaticResource Caption}" Text="CONNECTION" />
          <TextBlock x:Name="ConnectionText" Text="Stopped" FontWeight="SemiBold"
                     AutomationProperties.Name="Realtime connection state" />
        </StackPanel>

        <StackPanel Grid.Column="1">
          <TextBlock Style="{StaticResource Caption}" Text="ACCOUNT" />
          <TextBlock x:Name="AuthText" Text="Signed out" FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis"
                     AutomationProperties.Name="Authentication state" />
        </StackPanel>

        <StackPanel Grid.Column="2">
          <TextBlock Style="{StaticResource Caption}" Text="CACHED TRANSCRIPTS" />
          <TextBlock x:Name="CacheText" Text="0" FontWeight="SemiBold"
                     AutomationProperties.Name="Number of cached transcripts" />
        </StackPanel>
      </Grid>
    </Border>

    <TabControl x:Name="Tabs" Grid.Row="2" Background="Transparent" BorderThickness="0"
                AutomationProperties.Name="Sections">

      <!-- ============================ History ============================ -->
      <TabItem Header="_History">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <ListBox x:Name="HistoryList"
                   Grid.Row="0"
                   AutomationProperties.Name="Cached transcripts, newest first"
                   MouseDoubleClick="OnHistoryDoubleClick"
                   KeyDown="OnHistoryKeyDown">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding Preview}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Style="{StaticResource Caption}" Text="{Binding Meta}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock x:Name="EmptyHistoryText" Grid.Row="0"
                     Style="{StaticResource Caption}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     TextAlignment="Center"
                     Text="No transcripts cached yet.&#x0a;Completed transcripts appear here for 48 hours."
                     Visibility="Collapsed" />

          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="CopySelectedButton" Content="_Copy selected" Click="OnCopySelected"
                    Style="{StaticResource AccentButton}"
                    AutomationProperties.Name="Copy the selected transcript to the clipboard" />
            <Button x:Name="CopyLatestButton" Content="Copy _latest" Click="OnCopyLatest" Margin="8,0,0,0"
                    AutomationProperties.Name="Copy the newest transcript to the clipboard" />
            <Button x:Name="RefreshButton" Content="_Refresh" Click="OnRefresh" Margin="8,0,0,0"
                    AutomationProperties.Name="Refresh history from the backend" />
            <Button x:Name="ClearHistoryButton" Content="Clear _history" Click="OnClearHistory" Margin="8,0,0,0"
                    AutomationProperties.Name="Delete all locally cached transcripts" />
          </StackPanel>
        </Grid>
      </TabItem>

      <!-- ============================ Settings ============================ -->
      <TabItem Header="_Settings">
        <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel>

            <TextBlock Style="{StaticResource SectionHeader}" Text="Backend" />
            <TextBlock Style="{StaticResource Caption}" Text="API base URL" Margin="0,0,0,4" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="BackendUrlBox" Grid.Column="0"
                       AutomationProperties.Name="Backend API base URL" />
              <Button x:Name="ApplyUrlButton" Grid.Column="1" Content="_Apply" Margin="8,0,0,0"
                      Click="OnApplyUrl"
                      AutomationProperties.Name="Apply the backend URL" />
            </Grid>
            <TextBlock x:Name="BackendHealthText" Style="{StaticResource Caption}" Margin="0,6,0,0"
                       Text="Health not checked yet." />
            <Button x:Name="CheckHealthButton" Content="Check _connection" Click="OnCheckHealth"
                    HorizontalAlignment="Left" Margin="0,8,0,0"
                    AutomationProperties.Name="Check backend health" />

            <Separator Margin="0,18" Background="{StaticResource LineBrush}" />

            <TextBlock Style="{StaticResource SectionHeader}" Text="Google account" />
            <TextBlock x:Name="AuthDetailText" Style="{StaticResource Caption}" TextWrapping="Wrap"
                       Text="Not signed in." />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button x:Name="SignInButton" Content="Sign _in" Click="OnSignIn"
                      Style="{StaticResource AccentButton}"
                      AutomationProperties.Name="Sign in with Google in the system browser" />
              <Button x:Name="SignOutButton" Content="Sign _out" Click="OnSignOut" Margin="8,0,0,0"
                      AutomationProperties.Name="Sign out and delete cached tokens" />
            </StackPanel>

            <Separator Margin="0,18" Background="{StaticResource LineBrush}" />

            <TextBlock Style="{StaticResource SectionHeader}" Text="Behaviour" />
            <CheckBox x:Name="AutoStartCheck" Content="Start _automatically when I sign in to Windows"
                      Click="OnAutoStartChanged"
                      AutomationProperties.Name="Start VoicePrompt automatically at Windows sign-in" />
            <CheckBox x:Name="PauseCheck" Content="_Pause notifications (do not auto-copy transcripts)"
                      Click="OnPauseChanged"
                      AutomationProperties.Name="Pause notifications and automatic clipboard copying" />

            <Separator Margin="0,18" Background="{StaticResource LineBrush}" />

            <TextBlock Style="{StaticResource SectionHeader}" Text="About" />
            <TextBlock x:Name="AboutText" Style="{StaticResource Caption}" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
